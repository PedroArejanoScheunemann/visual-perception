{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VP_ENABLE_OPENCV": "ON",
        "VP_ENABLE_ONNX": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "component",
      "inherits": "base",
      "cacheVariables": {
        "VP_BUILD_COMPONENT_TESTS": "ON"
      }
    },
    {
      "name": "system",
      "inherits": "base",
      "cacheVariables": {
        "VP_BUILD_SYSTEM_TESTS": "ON"
      }
    },
    {
      "name": "test-all",
      "inherits": "base",
      "cacheVariables": {
        "VP_BUILD_COMPONENT_TESTS": "ON",
        "VP_BUILD_SYSTEM_TESTS": "ON"
      }
    },
    {
      "name": "benchmark",
      "inherits": "release",
      "cacheVariables": {
        "VP_BUILD_BENCHMARKS": "ON",
        "VP_ENABLE_PROFILING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "component",
      "configurePreset": "component"
    },
    {
      "name": "system",
      "configurePreset": "system"
    },
    {
      "name": "test-all",
      "configurePreset": "test-all"
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark"
    }
  ],
  "testPresets": [
    {
      "name": "component",
      "configurePreset": "component"
    },
    {
      "name": "system",
      "configurePreset": "system"
    },
    {
      "name": "test-all",
      "configurePreset": "test-all"
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark"
    }
  ]
}
